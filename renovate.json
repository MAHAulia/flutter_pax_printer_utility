{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Widen Dart/Flutter ranges instead of pinning exact versions (e.g. SDK constraints)",
      "matchManagers": ["pub"],
      "rangeStrategy": "widen"
    },
    {
      "description": "Plugin's standalone build stays on AGP 7.x until the Android build is modernised manually",
      "matchFileNames": ["android/build.gradle"],
      "matchPackageNames": ["com.android.tools.build:gradle"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Plugin's standalone Gradle wrapper stays on 7.x alongside AGP 7.x",
      "matchFileNames": ["android/gradle/wrapper/gradle-wrapper.properties"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep the example app's Android toolchain (Gradle, AGP, Kotlin) in one PR",
      "matchFileNames": [
        "example/android/settings.gradle",
        "example/android/gradle/wrapper/gradle-wrapper.properties"
      ],
      "groupName": "example android toolchain"
    }
  ]
}
