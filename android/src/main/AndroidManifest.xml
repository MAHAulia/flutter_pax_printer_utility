<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.mahatech.flutter_pax_printer_utility">

  <!-- Only what this plugin uses; library permissions are merged into every app that
       depends on it. Apps that use other PAX modules (card readers, PED, scanner) or the
       camera declare those permissions themselves. -->

  <!-- PAX printer -->
  <uses-permission android:name="com.pax.permission.PRINTER"/>

  <!-- printImageUrl -->
  <uses-permission android:name="android.permission.INTERNET"/>

</manifest>
